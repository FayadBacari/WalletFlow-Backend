@WalletFlow_Api_HostAddress = http://localhost:5150

# Les cookies de connexion sont Secure : la connexion et les routes suivantes s'essaient avec le profil https.
@WalletFlow_Api_SecureAddress = https://localhost:7078

# Description OpenAPI de l'API (en développement seulement)
GET {{WalletFlow_Api_HostAddress}}/openapi/v1.json
Accept: application/json

###

# Inscription d'un visiteur (GR Auth). En développement, l'e-mail arrive dans le dossier .local-emails.
POST {{WalletFlow_Api_HostAddress}}/api/account/register
Content-Type: application/json

{
  "email": "exemple@exemple.test",
  "password": "Exemple-De-Mot-De-Passe-1"
}

###

# Confirmation de l'adresse (GR Auth) : le jeton se lit après « #token= » dans le lien de l'e-mail.
POST {{WalletFlow_Api_HostAddress}}/api/account/confirm-email
Content-Type: application/json

{
  "token": "colle-ici-le-jeton-du-lien",
  "password": "Exemple-De-Mot-De-Passe-1"
}

###

# Connexion (GR Auth) : la réponse écrit le cookie de session et le cookie d'appareil.
POST {{WalletFlow_Api_SecureAddress}}/api/account/login
Content-Type: application/json

{
  "email": "exemple@exemple.test",
  "password": "Exemple-De-Mot-De-Passe-1"
}

###

# Jeton anti-CSRF de l'utilisateur connecté, à joindre aux requêtes qui modifient des données (SS §6).
GET {{WalletFlow_Api_SecureAddress}}/api/account/csrf-token
Accept: application/json

###

# Déconnexion (GR Auth) : détruit la session côté serveur.
POST {{WalletFlow_Api_SecureAddress}}/api/account/logout
X-CSRF-TOKEN: colle-ici-le-jeton-anti-csrf

###
