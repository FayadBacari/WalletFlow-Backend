@WalletFlow_Api_HostAddress = http://localhost:5150

# Les cookies de connexion sont Secure : la connexion et les routes suivantes s'essaient avec le profil https.
@WalletFlow_Api_SecureAddress = https://localhost:7078

# Description OpenAPI de l'API (en développement seulement)
GET {{WalletFlow_Api_HostAddress}}/openapi/v1.json
Accept: application/json

###

# Inscription d'un visiteur (GR Auth). En développement, l'e-mail arrive dans le dossier .local-emails.
POST {{WalletFlow_Api_HostAddress}}/api/account/register
Content-Type: application/json

{
  "email": "exemple@exemple.test",
  "password": "Exemple-De-Mot-De-Passe-1"
}

###

# Confirmation de l'adresse (GR Auth) : le jeton se lit après « #token= » dans le lien de l'e-mail.
POST {{WalletFlow_Api_HostAddress}}/api/account/confirm-email
Content-Type: application/json

{
  "token": "colle-ici-le-jeton-du-lien",
  "password": "Exemple-De-Mot-De-Passe-1"
}

###

# Connexion (GR Auth) : la réponse écrit le cookie de session et le cookie d'appareil.
POST {{WalletFlow_Api_SecureAddress}}/api/account/login
Content-Type: application/json

{
  "email": "exemple@exemple.test",
  "password": "Exemple-De-Mot-De-Passe-1"
}

###

# Jeton anti-CSRF de l'utilisateur connecté, à joindre aux requêtes qui modifient des données (SS §6).
GET {{WalletFlow_Api_SecureAddress}}/api/account/csrf-token
Accept: application/json

###

# Déconnexion (GR Auth) : détruit la session côté serveur.
POST {{WalletFlow_Api_SecureAddress}}/api/account/logout
X-CSRF-TOKEN: colle-ici-le-jeton-anti-csrf

###

# Mot de passe oublié (GR Auth) : même réponse pour toutes les adresses, l'e-mail part en arrière-plan.
POST {{WalletFlow_Api_HostAddress}}/api/account/forgot-password
Content-Type: application/json

{
  "email": "exemple@exemple.test"
}

###

# Nouveau mot de passe (GR Auth) : le jeton se lit après « #token= » dans le lien de l'e-mail.
POST {{WalletFlow_Api_HostAddress}}/api/account/reset-password
Content-Type: application/json

{
  "token": "colle-ici-le-jeton-du-lien",
  "newPassword": "Nouveau-Mot-De-Passe-2"
}

###

# Déblocage (GR Auth) : le jeton se lit après « #token= » dans le lien de l'e-mail. Ne connecte personne.
POST {{WalletFlow_Api_HostAddress}}/api/account/unlock
Content-Type: application/json

{
  "token": "colle-ici-le-jeton-du-lien"
}

###

# Fin de la connexion (GR Auth) : si la connexion répond isTwoFactorCodeRequired, envoie ici un code de l'application ou un code de secours.
# Le cookie de la connexion en attente est renvoyé automatiquement.
POST {{WalletFlow_Api_SecureAddress}}/api/account/login/two-factor
Content-Type: application/json

{
  "code": "123456"
}

###

# Début de l'activation (GR Auth, SS §2) : il faut être connecté et envoyer le jeton anti-CSRF. Donne le secret à ajouter à l'application.
POST {{WalletFlow_Api_SecureAddress}}/api/account/two-factor/start-activation
Content-Type: application/json
X-CSRF-TOKEN: colle-ici-le-jeton-anti-csrf

{
  "password": "Exemple-De-Mot-De-Passe-1"
}

###

# Fin de l'activation : un premier code juste active tout, et donne les 10 codes de secours, cette seule fois.
POST {{WalletFlow_Api_SecureAddress}}/api/account/two-factor/finish-activation
Content-Type: application/json
X-CSRF-TOKEN: colle-ici-le-jeton-anti-csrf

{
  "code": "123456"
}

###

# Désactivation : le mot de passe et un code de l'application ou de secours.
POST {{WalletFlow_Api_SecureAddress}}/api/account/two-factor/deactivate
Content-Type: application/json
X-CSRF-TOKEN: colle-ici-le-jeton-anti-csrf

{
  "password": "Exemple-De-Mot-De-Passe-1",
  "code": "123456"
}

###

# Profil (GR Compte) : l'adresse, le nom, le prénom et l'état de la double authentification. Il faut être connecté.
GET {{WalletFlow_Api_SecureAddress}}/api/account/profile

###

# Nom et prénom : sans mot de passe. Un champ vide ou absent efface ce qu'il y avait.
POST {{WalletFlow_Api_SecureAddress}}/api/account/name
Content-Type: application/json
X-CSRF-TOKEN: colle-ici-le-jeton-anti-csrf

{
  "lastName": "Dupont",
  "firstName": "Élise"
}

###

# Changement du mot de passe (GR Compte, SS §3) : le code n'est demandé que si la double authentification est activée.
# Les autres sessions sont fermées, et la session en cours reçoit un nouveau cookie.
POST {{WalletFlow_Api_SecureAddress}}/api/account/password
Content-Type: application/json
X-CSRF-TOKEN: colle-ici-le-jeton-anti-csrf

{
  "currentPassword": "Exemple-De-Mot-De-Passe-1",
  "newPassword": "Nouveau-Mot-De-Passe-2",
  "code": null
}

###

# Demande d'une nouvelle adresse (GR Compte, SS §2) : la réponse est la même, que l'adresse soit libre ou déjà utilisée.
POST {{WalletFlow_Api_SecureAddress}}/api/account/email
Content-Type: application/json
X-CSRF-TOKEN: colle-ici-le-jeton-anti-csrf

{
  "password": "Exemple-De-Mot-De-Passe-1",
  "newEmail": "nouvelle-adresse@exemple.test",
  "code": null
}

###

# Confirmation de la nouvelle adresse : le jeton se lit après « #token= » dans le lien reçu, et le mot de passe est redemandé.
# Cette route est appelée sans session.
POST {{WalletFlow_Api_HostAddress}}/api/account/confirm-email-change
Content-Type: application/json

{
  "token": "colle-ici-le-jeton-du-lien",
  "password": "Exemple-De-Mot-De-Passe-1"
}

###

# Catégories de l'utilisateur connecté, avec leur budget en centimes, dans l'ordre alphabétique, « Autres » à la fin (GR Dépenses).
GET {{WalletFlow_Api_SecureAddress}}/api/categories

###

# Création d'une catégorie (1 à 50 caractères, un nom pas encore utilisé, 100 catégories au plus).
POST {{WalletFlow_Api_SecureAddress}}/api/categories
Content-Type: application/json
X-CSRF-TOKEN: colle-ici-le-jeton-anti-csrf

{
  "name": "Abonnements"
}

###

# Nouveau nom d'une catégorie : l'identifiant se lit dans la liste. « Autres » ne se renomme pas.
PUT {{WalletFlow_Api_SecureAddress}}/api/categories/colle-ici-l-identifiant/name
Content-Type: application/json
X-CSRF-TOKEN: colle-ici-le-jeton-anti-csrf

{
  "name": "Streaming"
}

###

# Budget mensuel en centimes (de 1 à 1 000 000 000), ou null pour l'enlever. Le champ doit être écrit.
PUT {{WalletFlow_Api_SecureAddress}}/api/categories/colle-ici-l-identifiant/budget
Content-Type: application/json
X-CSRF-TOKEN: colle-ici-le-jeton-anti-csrf

{
  "monthlyBudgetInCents": 3000
}

###

# Suppression d'une catégorie : ses transactions passent dans « Autres ». « Autres » ne se supprime pas.
DELETE {{WalletFlow_Api_SecureAddress}}/api/categories/colle-ici-l-identifiant
X-CSRF-TOKEN: colle-ici-le-jeton-anti-csrf

###

# Banques que l'utilisateur peut connecter (GR Comptes). Il faut une application Enable Banking configurée.
GET {{WalletFlow_Api_SecureAddress}}/api/banks

###

# Début de la connexion d'une banque : la réponse donne l'adresse de sa page, où l'utilisateur s'identifie.
POST {{WalletFlow_Api_SecureAddress}}/api/bank-connections
Content-Type: application/json
X-CSRF-TOKEN: colle-ici-le-jeton-anti-csrf

{
  "bankName": "Mock ASPSP"
}

###

# Retour de la banque : le code et le state se lisent dans l'adresse de la page /bank-callback où la banque a renvoyé l'utilisateur.
POST {{WalletFlow_Api_SecureAddress}}/api/bank-connections/finish
Content-Type: application/json
X-CSRF-TOKEN: colle-ici-le-jeton-anti-csrf

{
  "code": "colle-ici-le-code",
  "state": "colle-ici-le-state"
}

###

# Banques connectées, comptes, soldes et date de chaque solde.
GET {{WalletFlow_Api_SecureAddress}}/api/bank-connections

###

# Mise à jour des soldes, à l'ouverture de l'application : une fois par minute au plus.
POST {{WalletFlow_Api_SecureAddress}}/api/bank-connections/refresh
X-CSRF-TOKEN: colle-ici-le-jeton-anti-csrf

###

# Renouvellement de l'autorisation d'une connexion : la réponse donne l'adresse de la banque.
POST {{WalletFlow_Api_SecureAddress}}/api/bank-connections/colle-ici-l-identifiant/renew
X-CSRF-TOKEN: colle-ici-le-jeton-anti-csrf

###

# Déconnexion d'une banque : l'autorisation est révoquée, puis la banque, ses comptes et leurs transactions sont supprimés.
DELETE {{WalletFlow_Api_SecureAddress}}/api/bank-connections/colle-ici-l-identifiant
X-CSRF-TOKEN: colle-ici-le-jeton-anti-csrf

###

# Solde total, tous comptes confondus, avec la date du plus ancien des soldes additionnés.
GET {{WalletFlow_Api_SecureAddress}}/api/balance

###

# Recherche d'opérations : chaque critère est facultatif. Le montant est en centimes et cherché sans son signe.
GET {{WalletFlow_Api_SecureAddress}}/api/transactions?text=carrefour&amountInCents=1250&from=2026-01-01&to=2026-12-31&page=1

###

# Changement de catégorie d'une opération, et, si demandé, des prochaines opérations qui ont le même libellé.
PUT {{WalletFlow_Api_SecureAddress}}/api/transactions/colle-ici-l-identifiant/category
Content-Type: application/json
X-CSRF-TOKEN: colle-ici-le-jeton-anti-csrf

{
  "categoryId": "colle-ici-l-identifiant-de-la-categorie",
  "applyToFutureTransactions": true
}

###

# Marque d'une opération comme transfert entre deux comptes de l'utilisateur, ou retrait de cette marque.
PUT {{WalletFlow_Api_SecureAddress}}/api/transactions/colle-ici-l-identifiant/transfer
Content-Type: application/json
X-CSRF-TOKEN: colle-ici-le-jeton-anti-csrf

{
  "isInternalTransfer": true
}

###
